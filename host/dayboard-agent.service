[Unit]
Description=Dayboard display agent (brightness, DPMS, mute)
# graphical.target here forms a boot ordering cycle; systemd deletes the start job
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/dayboard-agent/agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target